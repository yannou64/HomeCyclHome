# Environnement
NODE_ENV=development
PORT=3000

# Base de données (PostgreSQL) — utilisée par Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/homecyclhome"

# JWT (voir Backend/src/config/jwt.config.ts)
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# URL du frontend — utilisée pour la config CORS et les liens dans les emails
# transactionnels (ex: confirmation d'email)
FRONTEND_URL=http://localhost:5173

# Email transactionnel (SMTP — voir Backend/src/features/email/)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM="HomeCycl'Home <no-reply@example.com>"

# Stockage des photos d'intervention (AWS S3 — voir Backend/src/shared/storage/)
AWS_REGION=eu-west-3
AWS_S3_BUCKET=homecyclhome-photos
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
