generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  client
  technicien
  admin
}

enum StatutIntervention {
  Planifiee
  Terminee
  Annulee
}

model Utilisateur {
  id                       String    @id @default(uuid())
  nom                      String
  prenom                   String
  email                    String    @unique
  password_hash            String
  telephone                String
  role                     Role      @default(client)
  is_actif                 Boolean   @default(false)
  email_confirmation_token String?   @unique
  token_expires_at         DateTime?
  refresh_token_hash       String?
  date_creation            DateTime  @default(now())
  date_maj                 DateTime  @updatedAt
  date_dernier_login       DateTime?
  cycles                   Cycle[]               // relation inverse : un utilisateur possède plusieurs cycles
  adresses                 PeutSeSituer[]        // relation inverse : adresses liées au client
  zones_affectees          TechnicienZone[]      // relation inverse : zones affectées au technicien
  modeles_planification    ModelePlanification[] // relation inverse : modèles de planification du technicien
  pauses_recurrentes       PauseRecurrente[]     // relation inverse : pauses récurrentes du technicien
  indisponibilites         Indisponibilite[]     // relation inverse : absences ponctuelles du technicien
  interventions            Intervention[]        // relation inverse : interventions du client

  @@map("Utilisateurs")
}

// ─── Adresses ────────────────────────────────────────────────────────────────

model Adresse {
  id              String   @id @default(uuid())
  numero          String?
  rue             String
  code_postal     String
  ville           String
  pays            String   @default("France")
  latitude        Decimal  @db.Decimal(10, 8)
  longitude       Decimal  @db.Decimal(11, 8)
  // Identifiant unique Google Places — permet la déduplication lors de la création
  google_place_id String   @unique
  date_creation   DateTime @default(now())

  utilisateurs  PeutSeSituer[] // relation inverse : liaisons utilisateur ↔ adresse
  interventions Intervention[] // relation inverse : interventions à cette adresse

  @@map("Adresses")
}

// Table de liaison n-n Utilisateur ↔ Adresse
// Porte les métadonnées propres à la relation (label, statut, adresse principale)
model PeutSeSituer {
  id                String    @id @default(uuid())
  titre_description String?                      // label personnalisé affiché dans le dropdown (nullable)
  adresse_principal Boolean   @default(false)    // une seule adresse principale par client (règle enforced par transaction)
  is_valide         Boolean   @default(true)     // soft-delete : false = désactivée, ligne conservée pour l'historique
  date_creation     DateTime  @default(now())
  date_invalidite   DateTime?                    // renseigné lors du soft-delete

  utilisateur_id String
  adresse_id     String

  utilisateur Utilisateur @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade)
  adresse     Adresse     @relation(fields: [adresse_id], references: [id], onDelete: Cascade)

  @@map("PeutSeSituer")
}

model Marque {
  id      String  @id @default(uuid())
  libelle String  @unique
  cycles  Cycle[] // relation inverse : une marque peut être associée à plusieurs cycles

  @@map("Marques")
}

model TypeCycle {
  id      String  @id @default(uuid())
  libelle String  @unique
  cycles  Cycle[] // relation inverse : un type peut être associé à plusieurs cycles

  @@map("TypesCycles")
}

model Cycle {
  id            String      @id @default(uuid())
  libelle       String                           // nom choisi par l'utilisateur (ex: "Mon VTT de trail")
  particularite String?                          // champ libre optionnel (ex: "roues 29 pouces")
  date_creation DateTime    @default(now())

  // Clés étrangères (colonnes réelles en base)
  utilisateur_id String
  marque_id      String
  type_cycle_id  String

  // Relations Prisma (navigation, pas de colonne créée)
  utilisateur   Utilisateur  @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade)
  marque        Marque       @relation(fields: [marque_id], references: [id])
  type_cycle    TypeCycle    @relation(fields: [type_cycle_id], references: [id])
  interventions Intervention[] // relation inverse : interventions pour ce cycle

  @@map("Cycles")
}

model Forfait {
  id              String                   @id @default(uuid())
  nom             String                   @unique
  description     String?
  duree_minutes   Int
  is_actif        Boolean                  @default(true)
  date_creation   DateTime                 @default(now())
  historique_prix HistoriquePrixForfait[]  // relation virtuelle — aucune colonne créée
  interventions   Intervention[]           // relation inverse : interventions pour ce forfait

  @@map("Forfaits")
}

model HistoriquePrixForfait {
  id         String    @id @default(uuid())
  montant    Decimal   @db.Decimal(10, 2)
  date_debut DateTime
  date_fin   DateTime?
  forfait_id    String
  forfait       Forfait        @relation(fields: [forfait_id], references: [id])
  interventions Intervention[] // relation inverse : interventions ayant ce snapshot de prix

  @@map("HistoriquePrixForfaits")
}

model Zone {
  id            String      @id @default(uuid())
  nom_zone      String      @unique
  is_active     Boolean     @default(true)
  date_creation DateTime    @default(now())
  points                ZonePoint[]
  techniciens_affectes  TechnicienZone[]      // relation inverse : techniciens affectés à cette zone
  modeles_planification ModelePlanification[] // relation inverse : modèles de planification sur cette zone
  creneaux              Creneau[]             // relation inverse : créneaux générés sur cette zone

  @@map("Zones")
}

model ZonePoint {
  id        String  @id @default(uuid())
  latitude  Decimal @db.Decimal(10, 8)
  longitude Decimal @db.Decimal(11, 8)
  ordre     Int
  zone_id   String
  zone      Zone    @relation(fields: [zone_id], references: [id], onDelete: Cascade)

  @@map("ZonesPoints")
}

model TechnicienZone {
  technicien_id    String
  zone_id          String
  date_affectation DateTime    @default(now())
  technicien       Utilisateur @relation(fields: [technicien_id], references: [id], onDelete: Cascade)
  zone             Zone        @relation(fields: [zone_id], references: [id], onDelete: Cascade)

  @@id([technicien_id, zone_id])
  @@map("TechnicienZones")
}

// ─── Planification ───────────────────────────────────────────────────────────

model ModelePlanification {
  id                   String    @id @default(uuid())
  // 0=lundi, 1=mardi, 2=mercredi, 3=jeudi, 4=vendredi, 5=samedi, 6=dimanche
  jour_semaine         Int
  // Heures stockées en minutes depuis minuit pour simplifier les calculs d'overlap
  // Exemples : 8h30 → 510, 17h00 → 1020
  heure_debut          Int
  heure_fin            Int
  // Durée de chaque créneau généré (ex: 60 = créneaux d'une heure)
  intervalle_minutes   Int
  is_actif             Boolean   @default(true)
  date_debut_validite  DateTime
  date_fin_validite    DateTime? // null = valable indéfiniment
  date_creation        DateTime  @default(now())

  technicien_id        String
  zone_id              String

  technicien           Utilisateur @relation(fields: [technicien_id], references: [id], onDelete: Cascade)
  zone                 Zone        @relation(fields: [zone_id], references: [id], onDelete: Cascade)
  creneaux             Creneau[]   // relation inverse : créneaux générés depuis ce modèle

  @@map("ModelesPlanification")
}

model PauseRecurrente {
  id            String    @id @default(uuid())
  // null = la pause s'applique tous les jours de la semaine
  jour_semaine  Int?
  heure_debut   Int       // minutes depuis minuit
  heure_fin     Int       // minutes depuis minuit
  description   String?
  date_creation DateTime  @default(now())

  technicien_id String
  technicien    Utilisateur @relation(fields: [technicien_id], references: [id], onDelete: Cascade)

  @@map("PausesRecurrentes")
}

model Indisponibilite {
  id            String   @id @default(uuid())
  date_debut    DateTime
  date_fin      DateTime
  motif         String?
  date_creation DateTime @default(now())

  technicien_id String
  technicien    Utilisateur @relation(fields: [technicien_id], references: [id], onDelete: Cascade)

  @@map("Indisponibilites")
}

// Creneau : entité cible de la génération (HOM-285)
// Défini maintenant pour stabiliser le schéma — les use cases de génération arrivent au sprint suivant
model Creneau {
  id            String    @id @default(uuid())
  date_debut    DateTime
  date_fin      DateTime? // null à la génération, calculé lors de la réservation
  is_disponible Boolean   @default(true)
  date_creation DateTime  @default(now())

  // FK nullable : null pour les créneaux manuels (futur), renseigné pour les créneaux générés
  modele_planification_id String?
  // Snapshot de la zone — dénormalisé intentionnellement pour la stabilité des requêtes client
  zone_id                 String

  modele_planification ModelePlanification? @relation(fields: [modele_planification_id], references: [id], onDelete: SetNull)
  zone                 Zone                 @relation(fields: [zone_id], references: [id], onDelete: Cascade)
  intervention         Intervention?        // relation inverse 1-1 : un créneau → au plus une intervention

  @@map("Creneaux")
}

// ─── Interventions ───────────────────────────────────────────────────────────

model Intervention {
  id                         String             @id @default(uuid())
  statut                     StatutIntervention @default(Planifiee)
  commentaire                String?
  duree_minutes_snapshot     Int                // snapshot de Forfait.duree_minutes au moment de la réservation
  date_creation              DateTime           @default(now())
  date_maj                   DateTime           @updatedAt

  client_id                  String
  cycle_id                   String
  forfait_id                 String
  creneau_id                 String             @unique // unicité : 1 créneau = 1 seule intervention possible
  adresse_id                 String
  historique_prix_forfait_id String             // snapshot du prix actif au moment de la réservation
  technicien_id              String?            // snapshot depuis ModelePlanification (nullable si créneau manuel)

  client          Utilisateur           @relation(fields: [client_id],                   references: [id])
  cycle           Cycle                 @relation(fields: [cycle_id],                    references: [id])
  forfait         Forfait               @relation(fields: [forfait_id],                  references: [id])
  creneau         Creneau               @relation(fields: [creneau_id],                  references: [id])
  adresse         Adresse               @relation(fields: [adresse_id],                  references: [id])
  historique_prix HistoriquePrixForfait @relation(fields: [historique_prix_forfait_id],  references: [id])

  @@map("Interventions")
}
