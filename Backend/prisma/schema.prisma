generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  client
  technicien
  admin
}

// Statuts d'une intervention (glossaire V2) : pas de statut « Clôturé », la
// clôture est portée par date_cloture.
enum StatutIntervention {
  Planifiee
  Realisee
  Annulee
  EnConflit
}

// Statuts d'un créneau de 30 minutes (glossaire V2)
enum StatutCreneau {
  Libre
  InterventionReservee
  Deplacement
}

// Palette fixe des zones (Refonte 2.0, Énumérations) : la base enregistre le
// nom, l'interface fait la correspondance avec le code hexadécimal.
enum CouleurZone {
  Rouge
  Orange
  Jaune
  Lime
  Vert
  Turquoise
  Cyan
  Bleu
  Indigo
  Violet
  Prune
  Rose
}

model Utilisateur {
  id                       String                @id @default(uuid())
  nom                      String
  prenom                   String
  email                    String                @unique
  password_hash            String
  telephone                String
  role                     Role                  @default(client)
  is_actif                 Boolean               @default(false)
  email_confirmation_token String?               @unique
  token_expires_at         DateTime?
  refresh_token_hash       String?
  date_creation            DateTime              @default(now())
  date_maj                 DateTime              @updatedAt
  date_dernier_login       DateTime?
  cycles                   Cycle[] // relation inverse : un utilisateur possède plusieurs cycles
  adresses                 PeutSeSituer[] // relation inverse : adresses liées au client
  zones_affectees          TechnicienZone[] // relation inverse : zones affectées au technicien
  modeles_planification    ModelePlanification[] // relation inverse : modèles de planification du technicien
  creneaux                 Creneau[] // relation inverse : créneaux du technicien
  interventions            Intervention[]        @relation("InterventionClient") // interventions du client
  interventions_technicien Intervention[]        @relation("InterventionTechnicien") // interventions assurées par le technicien

  @@map("Utilisateurs")
}

// ─── Adresses ────────────────────────────────────────────────────────────────

model Adresse {
  id              String   @id @default(uuid())
  numero          String?
  rue             String
  code_postal     String
  ville           String
  pays            String   @default("France")
  latitude        Decimal  @db.Decimal(10, 8)
  longitude       Decimal  @db.Decimal(11, 8)
  // Identifiant unique Google Places — permet la déduplication lors de la création
  google_place_id String   @unique
  date_creation   DateTime @default(now())

  utilisateurs  PeutSeSituer[] // relation inverse : liaisons utilisateur ↔ adresse
  interventions Intervention[] // relation inverse : interventions à cette adresse

  @@map("Adresses")
}

// Table de liaison n-n Utilisateur ↔ Adresse
// Porte les métadonnées propres à la relation (label, statut, adresse principale)
model PeutSeSituer {
  id                String    @id @default(uuid())
  titre_description String? // label personnalisé affiché dans le dropdown (nullable)
  adresse_principal Boolean   @default(false) // une seule adresse principale par client (règle enforced par transaction)
  is_valide         Boolean   @default(true) // soft-delete : false = désactivée, ligne conservée pour l'historique
  date_creation     DateTime  @default(now())
  date_invalidite   DateTime? // renseigné lors du soft-delete

  utilisateur_id String
  adresse_id     String

  utilisateur Utilisateur @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade)
  adresse     Adresse     @relation(fields: [adresse_id], references: [id], onDelete: Cascade)

  @@map("PeutSeSituer")
}

model Marque {
  id      String  @id @default(uuid())
  libelle String  @unique
  cycles  Cycle[] // relation inverse : une marque peut être associée à plusieurs cycles

  @@map("Marques")
}

model TypeCycle {
  id      String  @id @default(uuid())
  libelle String  @unique
  cycles  Cycle[] // relation inverse : un type peut être associé à plusieurs cycles

  @@map("TypesCycles")
}

model Cycle {
  id            String   @id @default(uuid())
  libelle       String // nom choisi par l'utilisateur (ex: "Mon VTT de trail")
  particularite String? // champ libre optionnel (ex: "roues 29 pouces")
  date_creation DateTime @default(now())

  // Clés étrangères (colonnes réelles en base)
  utilisateur_id String
  marque_id      String
  type_cycle_id  String

  // Relations Prisma (navigation, pas de colonne créée)
  utilisateur   Utilisateur    @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade)
  marque        Marque         @relation(fields: [marque_id], references: [id])
  type_cycle    TypeCycle      @relation(fields: [type_cycle_id], references: [id])
  interventions Intervention[] // relation inverse : interventions pour ce cycle

  @@map("Cycles")
}

model Forfait {
  id              String                  @id @default(uuid())
  nom             String                  @unique
  description     String?
  duree_minutes   Int
  is_actif        Boolean                 @default(true)
  date_creation   DateTime                @default(now())
  historique_prix HistoriquePrixForfait[] // relation virtuelle — aucune colonne créée

  @@map("Forfaits")
}

model HistoriquePrixForfait {
  id            String         @id @default(uuid())
  montant       Decimal        @db.Decimal(10, 2)
  date_debut    DateTime
  date_fin      DateTime?
  forfait_id    String
  forfait       Forfait        @relation(fields: [forfait_id], references: [id])
  interventions Intervention[] // relation inverse : interventions ayant ce snapshot de prix

  @@map("HistoriquePrixForfaits")
}

model Zone {
  id                    String                @id @default(uuid())
  nom_zone              String                @unique
  is_active             Boolean               @default(true)
  // Aucune unicité : deux zones peuvent avoir la même couleur. Rouge, la
  // première de la palette, est celle que l'interface présélectionne.
  couleur               CouleurZone           @default(Rouge)
  date_creation         DateTime              @default(now())
  points                ZonePoint[]
  techniciens_affectes  TechnicienZone[] // relation inverse : techniciens affectés à cette zone
  modeles_planification ModelePlanification[] // relation inverse : modèles de planification sur cette zone
  creneaux              Creneau[] // relation inverse : créneaux de la zone

  @@map("Zones")
}

model ZonePoint {
  id        String  @id @default(uuid())
  latitude  Decimal @db.Decimal(10, 8)
  longitude Decimal @db.Decimal(11, 8)
  ordre     Int
  zone_id   String
  zone      Zone    @relation(fields: [zone_id], references: [id], onDelete: Cascade)

  @@map("ZonesPoints")
}

model TechnicienZone {
  technicien_id    String
  zone_id          String
  date_affectation DateTime    @default(now())
  technicien       Utilisateur @relation(fields: [technicien_id], references: [id], onDelete: Cascade)
  zone             Zone        @relation(fields: [zone_id], references: [id], onDelete: Cascade)

  @@id([technicien_id, zone_id])
  @@map("TechnicienZones")
}

// ─── Planification ───────────────────────────────────────────────────────────

// Modèle : une saisie préremplie pour planifier (intitulé, blocs horaires,
// zone, jours). Il ne produit aucun créneau et aucun créneau ne s'y rattache.
model ModelePlanification {
  id            String   @id @default(uuid())
  intitule      String
  lundi         Boolean  @default(false)
  mardi         Boolean  @default(false)
  mercredi      Boolean  @default(false)
  jeudi         Boolean  @default(false)
  vendredi      Boolean  @default(false)
  samedi        Boolean  @default(false)
  dimanche      Boolean  @default(false)
  date_creation DateTime @default(now())

  technicien_id String
  // Obligatoire (RG5 d'Administrer les modèles) ; écart avec le 0,1 du MCD
  // consigné dans le vault le 16/11/2026.
  zone_id       String

  technicien Utilisateur   @relation(fields: [technicien_id], references: [id], onDelete: Cascade)
  zone       Zone          @relation(fields: [zone_id], references: [id], onDelete: Cascade)
  blocs      BlocHoraire[]

  @@map("ModelesPlanification")
}

// Plage horaire d'un modèle. Heures en minutes depuis minuit (8h30 → 510),
// bornées à la plage 7h00–20h00 par le code. Un modèle porte plusieurs blocs.
model BlocHoraire {
  id    String @id @default(uuid())
  debut Int
  fin   Int

  modele_planification_id String
  modele_planification    ModelePlanification @relation(fields: [modele_planification_id], references: [id], onDelete: Cascade)

  @@map("BlocsHoraires")
}

// Créneau : tranche de 30 minutes d'un technicien dans une zone. Il ne se
// rattache à aucun modèle.
model Creneau {
  id            String        @id @default(uuid())
  date_debut    DateTime // fin = date_debut + 30 min, toujours
  statut        StatutCreneau @default(Libre)
  date_creation DateTime      @default(now())

  technicien_id   String
  zone_id         String
  // Renseigné seulement pour un créneau « Intervention réservée » ; vidé dans
  // la même écriture quand le créneau redevient Libre ou Déplacement.
  intervention_id String?

  technicien   Utilisateur   @relation(fields: [technicien_id], references: [id], onDelete: Cascade)
  zone         Zone          @relation(fields: [zone_id], references: [id], onDelete: Cascade)
  intervention Intervention? @relation(fields: [intervention_id], references: [id], onDelete: Restrict)

  // Un technicien n'a qu'un créneau par horaire (Refonte 2.0, contraintes)
  @@unique([technicien_id, date_debut])
  @@map("Creneaux")
}

// ─── Interventions ───────────────────────────────────────────────────────────

// Aucune intervention n'est supprimée (décision du 16/11/2026) : les clés
// étrangères vers Utilisateurs, Cycles et Adresses sont restrictives (comportement
// par défaut), ce qui empêche de supprimer un compte lié à des interventions.
model Intervention {
  id                     String             @id @default(uuid())
  statut                 StatutIntervention @default(Planifiee)
  commentaire_client     String? // saisi par le client à la réservation
  // Commentaire partagé (technicien, admin, système) : chaque ajout est
  // concaténé en tête, précédé de la date, de l'heure et de l'auteur.
  // Jamais visible du client.
  commentaire_technicien String?
  // Snapshots figés à la réservation : la donnée reste lisible même si ses
  // créneaux sont supprimés ou si le forfait change.
  duree_minutes_snapshot Int
  date_prevue            DateTime
  date_cloture           DateTime? // renseignée = clôturée (case réversible)
  date_creation          DateTime           @default(now())
  date_maj               DateTime           @updatedAt

  client_id                  String
  technicien_id              String
  cycle_id                   String
  adresse_id                 String
  historique_prix_forfait_id String // prix actif à la réservation ; mène au forfait

  client          Utilisateur           @relation("InterventionClient", fields: [client_id], references: [id])
  technicien      Utilisateur           @relation("InterventionTechnicien", fields: [technicien_id], references: [id])
  cycle           Cycle                 @relation(fields: [cycle_id], references: [id])
  adresse         Adresse               @relation(fields: [adresse_id], references: [id])
  historique_prix HistoriquePrixForfait @relation(fields: [historique_prix_forfait_id], references: [id])

  creneaux Creneau[] // le bloc réservé : les créneaux portent le lien
  paiement Paiement?
  photos   Photo[]

  @@map("Interventions")
}

// Un seul paiement par intervention : un nouveau passage en Réalisée remplace
// le paiement existant.
model Paiement {
  id            String   @id @default(uuid())
  montant_total Decimal  @db.Decimal(10, 2) // montant encaissé
  date_paiement DateTime // date d'encaissement
  // Texte validé par le code contre l'énumération des modes de paiement
  // (Espèces, Carte bancaire, Chèque, Virement) : aucune table à administrer.
  mode_paiement String
  date_creation DateTime @default(now())

  intervention_id String       @unique
  intervention    Intervention @relation(fields: [intervention_id], references: [id])

  @@map("Paiements")
}

// ─── Photos ──────────────────────────────────────────────────────────────────

enum ContextePhoto {
  client // Photo ajoutée par le client lors de la réservation
  technicien // Photo ajoutée par le technicien à la clôture de l'intervention
}

model Photo {
  id            String        @id @default(uuid())
  url_s3        String // URL complète HTTPS du fichier sur S3
  cle_s3        String // Clé S3 — conservée pour permettre la suppression du fichier
  contexte      ContextePhoto // Discriminateur : qui a uploadé et à quelle étape
  date_creation DateTime      @default(now())

  intervention_id String
  intervention    Intervention @relation(fields: [intervention_id], references: [id], onDelete: Cascade)

  @@map("Photos")
}
