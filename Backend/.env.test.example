# Modèle de Backend/.env.test (tests d'intégration, npm run test:e2e).
# Copier en .env.test (non versionné) et adapter DATABASE_URL.
# Aucune vraie clé : email et S3 sont remplacés par des faux dans les tests.
NODE_ENV=test
PORT=3001

# Base dédiée aux tests : son nom DOIT finir par _test (garde-fou du banc)
DATABASE_URL=postgresql://UTILISATEUR:MOTDEPASSE@localhost:5432/homecycl_test

JWT_ACCESS_SECRET=secret-acces-de-test
JWT_REFRESH_SECRET=secret-refresh-de-test
FRONTEND_URL=http://localhost:5173

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=test
MAIL_PASS=test
MAIL_FROM=test@homecyclhome.test
AWS_REGION=eu-west-3
AWS_S3_BUCKET=bucket-de-test
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
